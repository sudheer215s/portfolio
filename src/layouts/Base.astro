---
import { Font } from "astro:assets";
import "../styles/entry.css";
import SkipLink from "../components/chrome/SkipLink.astro";
import RunningHeader from "../components/chrome/RunningHeader.astro";
import Nav from "../components/chrome/Nav.astro";
import Footer from "../components/chrome/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  showRail?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0E0D0B" />
    <Font
      cssVariable="--font-plex-sans"
      preload={[{ weight: 600, style: "normal" }]}
    />
    <Font cssVariable="--font-plex-serif" />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body>
    <div class="page">
      <SkipLink />
      <header class="doc-header">
        <RunningHeader />
        <Nav />
      </header>
      <main class="page-main" id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
