---
import { seeking, site } from "../../data/site";
---

<div class="seeking-grid">
  <section class="seek-panel">
    <h3>Looking for</h3>
    <p>{seeking.lookingForShort}</p>
    <p class="chip-row">
      {seeking.lookingChips.map((chip) => <span class="chip">{chip}</span>)}
    </p>
  </section>
  <section class="seek-panel">
    <h3>Will not do</h3>
    <p>{seeking.avoidingShort}</p>
    <p class="chip-row">
      {seeking.avoidingChips.map((chip) => (
        <span class="chip chip-quiet">{chip}</span>
      ))}
    </p>
  </section>
</div>
<p class="education">{site.education.line}</p>
<details class="spec-details">
  <summary>Full notes</summary>
  <p>{seeking.lookingFor}</p>
  <p>{seeking.avoiding}</p>
</details>
