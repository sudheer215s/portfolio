---
import type { CollectionEntry } from "astro:content";
import { proofs } from "../../data/site";
import WorkFigure from "../figures/WorkFigure.astro";
import ConformanceTable from "./ConformanceTable.astro";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const data = entry.data;
const relatedProofs = proofs.filter((proof) => data.proofIds.includes(proof.id));
const proofValue = relatedProofs.length
  ? relatedProofs.map((proof) => `${proof.value} ${proof.qualifier}`).join(" · ")
  : (data.proofNote ?? "");
const repoValue = data.repo ?? "No public repo";
---

<article class="work-card" id={`work-${data.slug}`}>
  <p class="clause-kicker">{data.clause}</p>
  <div class="work-card-top">
    <h3>{data.name}</h3>
    <p class="work-status">{data.statusLabel}</p>
  </div>
  <WorkFigure slug={data.slug} />
  <p class="work-scan">{data.problem}</p>
  {
    relatedProofs.length > 0 && (
      <p class="work-metrics">
        {relatedProofs.map((proof) => (
          <span>
            <strong>{proof.value}</strong>
            {proof.qualifier}
          </span>
        ))}
      </p>
    )
  }
  <p class="chip-row">
    {data.stack.slice(0, 6).map((item) => <span class="chip">{item}</span>)}
  </p>
  <p class="work-links">
    {
      data.publishPage ? (
        <a href={`/work/${data.slug}`}>Read the case →</a>
      ) : null
    }
    {
      data.repo ? (
        <a href={data.repo} rel="noopener noreferrer">
          GitHub
        </a>
      ) : (
        <span class="muted">No public repo</span>
      )
    }
  </p>
  <details class="spec-details">
    <summary>Spec table</summary>
    <ConformanceTable
      rows={[
        { label: "Problem", value: data.problem },
        { label: "Constraint", value: data.constraint },
        { label: "Stack", value: [...data.stack] },
        { label: "Proof", value: proofValue || "—" },
        { label: "Repo", value: repoValue },
        { label: "Status", value: data.statusLabel },
      ]}
    />
  </details>
</article>
