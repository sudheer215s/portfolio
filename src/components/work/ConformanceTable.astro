---
interface Row {
  label: string;
  value: string | string[];
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<table class="conformance">
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>
            {Array.isArray(row.value) ? (
              <span class="stack-list">{row.value.join(" · ")}</span>
            ) : (
              row.value
            )}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
