---
import { site } from "../../data/site";
import { commitSha } from "../../data/commit";
---

<footer class="doc-footer" id="annex-a">
  <p class="footer-meta">
    © {site.person.name} · {commitSha} · {site.document.id}
    {site.document.version}
  </p>
  <p class="footer-confidentiality">{site.confidentiality}</p>
  <p class="footer-links">
    <a href={`mailto:${site.person.email}`}>{site.person.email}</a>
    <a href={site.person.github} rel="noopener noreferrer">GitHub</a>
    <a href={site.person.linkedin} rel="noopener noreferrer">LinkedIn</a>
    <a href="/resume.pdf">Resume</a>
  </p>
</footer>
