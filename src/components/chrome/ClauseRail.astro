---
const clauses = [
  { href: "/#scope", number: "1", label: "Scope" },
  { href: "/#work", number: "2", label: "Work items" },
  { href: "/#work", number: "2.1", label: "ClauseNotebook", indent: true },
  { href: "/#work", number: "2.2", label: "TranslateLive", indent: true },
  { href: "/#work", number: "2.3", label: "Social backend", indent: true },
  { href: "/#production", number: "3", label: "Production" },
  { href: "/#seeking", number: "4", label: "Seeking" },
  { href: "/#stack", number: "5", label: "Definitions" },
  { href: "#annex-a", number: "A", label: "Contact" },
] as const;
---

<nav class="clause-rail" aria-label="Clause map">
  <ol>
    {
      clauses.map((clause) => (
        <li class:list={[{ indent: "indent" in clause && clause.indent }]}>
          <a href={clause.href}>
            <span class="rail-num">{clause.number}</span>
            <span class="rail-label">{clause.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
