---
interface Props {
  slug: "clausenotebook" | "translatelive" | "distributed-social";
}

const { slug } = Astro.props;
---

{
  slug === "clausenotebook" && (
    <svg
      class="figure-svg"
      viewBox="0 0 560 92"
      role="img"
      aria-label="ClauseNotebook: PDF registered, hashed, converted to Markdown"
    >
      <rect class="fig-node" x="8" y="18" width="140" height="56" />
      <text class="fig-kicker" x="78" y="40">source</text>
      <text class="fig-label" x="78" y="58">PDF</text>

      <path class="fig-arrow" d="M156 46 H216" />
      <text class="fig-edge" x="186" y="38">SHA-256</text>

      <rect class="fig-node is-accent" x="216" y="18" width="140" height="56" />
      <text class="fig-kicker is-on" x="286" y="40">registered</text>
      <text class="fig-label is-on" x="286" y="58">manifest</text>

      <path class="fig-arrow" d="M364 46 H424" />
      <text class="fig-edge" x="394" y="38">convert</text>

      <rect class="fig-node" x="424" y="18" width="128" height="56" />
      <text class="fig-kicker" x="488" y="40">converted</text>
      <text class="fig-label" x="488" y="58">Markdown</text>
    </svg>
  )
}

{
  slug === "translatelive" && (
    <svg
      class="figure-svg"
      viewBox="0 0 560 92"
      role="img"
      aria-label="TranslateLive pipeline: speech to text, GPT translation, speech playback, under three seconds"
    >
      <rect class="fig-node" x="8" y="18" width="112" height="56" />
      <text class="fig-kicker" x="64" y="40">1</text>
      <text class="fig-label" x="64" y="58">STT</text>

      <path class="fig-arrow" d="M128 46 H176" />

      <rect class="fig-node is-accent" x="176" y="18" width="112" height="56" />
      <text class="fig-kicker is-on" x="232" y="40">2</text>
      <text class="fig-label is-on" x="232" y="58">GPT</text>

      <path class="fig-arrow" d="M296 46 H344" />

      <rect class="fig-node" x="344" y="18" width="112" height="56" />
      <text class="fig-kicker" x="400" y="40">3</text>
      <text class="fig-label" x="400" y="58">TTS</text>

      <rect class="fig-budget" x="472" y="28" width="80" height="36" />
      <text class="fig-budget-text" x="512" y="50">&lt;3s</text>
    </svg>
  )
}

{
  slug === "distributed-social" && (
    <svg
      class="figure-svg"
      viewBox="0 0 560 92"
      role="img"
      aria-label="Five services over gRPC with a Kafka outbox: User, Post, Graph, Notification, Search"
    >
      <rect class="fig-node" x="8" y="22" width="96" height="48" />
      <text class="fig-label" x="56" y="50">User</text>
      <rect class="fig-node" x="116" y="22" width="96" height="48" />
      <text class="fig-label" x="164" y="50">Post</text>
      <rect class="fig-node is-accent" x="224" y="22" width="96" height="48" />
      <text class="fig-label is-on" x="272" y="50">Graph</text>
      <rect class="fig-node" x="332" y="22" width="110" height="48" />
      <text class="fig-label" x="387" y="50">Notify</text>
      <rect class="fig-node" x="454" y="22" width="98" height="48" />
      <text class="fig-label" x="503" y="50">Search</text>
      <text class="fig-edge" x="280" y="14">gRPC · Kafka outbox · Redis fan-out</text>
    </svg>
  )
}
