---
import type { CitationToken } from "../../data/site";
import { citationAccessibleName } from "../../data/citations";

interface Props {
  tokens: readonly CitationToken[];
}

const { tokens } = Astro.props;
const label = citationAccessibleName(tokens);
---

<span class="citation" title={label}>
  <span class="visually-hidden">{label}. </span>
  {tokens.map((token) => `[${token}]`).join("")}
</span>
