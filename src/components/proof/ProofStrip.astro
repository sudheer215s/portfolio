---
import { proofs } from "../../data/site";
import ProofCell from "./ProofCell.astro";

const heroProofs = proofs.filter((proof) =>
  (proof.surfaces as readonly string[]).includes("hero"),
);
---

<ul class="proof-strip" aria-label="Proof numbers">
  {
    heroProofs.map((proof) => (
      <ProofCell
        value={proof.value}
        qualifier={proof.qualifier}
        detail={proof.detail}
        citations={proof.citations}
        describedById={`proof-detail-${proof.id}`}
      />
    ))
  }
</ul>
