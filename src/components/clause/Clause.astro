---
interface Props {
  id: string;
  number: string;
  title: string;
}

const { id, number, title } = Astro.props;
---

<section class="clause" id={id} aria-labelledby={`${id}-heading`}>
  <slot name="heading">
    <div class="clause-heading" id={`${id}-heading`}>
      <span class="clause-kicker">{number}</span>
      <span class="clause-title">{title}</span>
    </div>
  </slot>
  <slot />
</section>
