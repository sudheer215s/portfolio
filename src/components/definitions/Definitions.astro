---
import { stack } from "../../data/site";

const groups = [
  { label: "Languages", items: stack.languages },
  { label: "Backend", items: stack.backend },
  { label: "Data", items: stack.data },
  { label: "Infra", items: stack.infra },
  { label: "LLM", items: stack.llm },
] as const;
---

<div class="definitions">
  {
    groups.map((group) => (
      <div class="def-block">
        <p class="def-label">{group.label}</p>
        <p class="chip-row">
          {group.items.map((item) => (
            <span class="chip">{item}</span>
          ))}
        </p>
      </div>
    ))
  }
  <p class="llm-caveat">{stack.llmCaveat}</p>
</div>
